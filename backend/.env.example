# Database Configuration
# Primary: PostgreSQL (e.g., PostgreSQL running on port 5433 or 5432)
# Fallback: SQLite is supported for testing and isolated local environments
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mental_health_db

# Security & JWT Authentication
# IMPORTANT: Generate a strong random key in production (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY=dev_super_secret_jwt_key_change_in_production_min_32_chars_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Bootstrap Configuration
INITIAL_ADMIN_EMAIL=admin@mentalhealth.ai
INITIAL_ADMIN_PASSWORD=AdminSecurePass@2026
INITIAL_ADMIN_FULL_NAME=System Administrator

# Application Configuration
APP_NAME="AI-Based Mental Health Risk Prediction System"
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ML Model Configuration
MODEL_DIR=artifacts
DATA_DIR=data
DATASET_FILENAME=student_depression_dataset.csv
MODEL_VERSION=1.0.0
